# ==============================================
# ClientPulse Environment Configuration Template
# Copy this file to .env for local development
# ==============================================

# Backend Configuration
APP_ENV=development
DATABASE_URL=postgresql+psycopg://postgres:your_password@localhost:5432/customer_db

# JWT Security
# Generate a secure 256-bit key using: openssl rand -hex 32
JWT_SECRET_KEY=change-this-to-a-secure-random-32-char-secret-key
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (comma-separated URLs)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Redis Cache (optional, falls back to in-memory)
REDIS_URL=redis://localhost:6379/0

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
